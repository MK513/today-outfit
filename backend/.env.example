# 이 파일을 .env로 복사한 뒤 값을 채운다:  cp .env.example .env
# .env는 docker compose와 Spring Boot(bootRun · test)가 함께 읽는다.

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=today_outfit
DB_USERNAME=today_outfit
# 임의의 긴 문자열. 생성 예: python -c "import secrets;print(secrets.token_urlsafe(24))"
DB_PASSWORD=

# (선택) 전체 JDBC URL을 직접 지정하면 위 HOST/PORT/NAME 대신 사용한다. 배포 환경용.
# DB_URL=jdbc:postgresql://host:5432/today_outfit

# --- JWT (2단계 인증에서 사용) ---
# 32바이트 이상 랜덤 값의 Base64. 생성 예: python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
JWT_SECRET=

# --- 사진 저장 (선택) ---
# 저장소 구현. 현재는 local만 있다.
# IMAGE_STORAGE=local
# local 저장소 폴더. 기본값 ./uploads/images (backend/ 기준). 배포 시 영구 저장되는 경로로 지정한다.
# IMAGE_DIR=

# --- AI (실제 LLM 연동 단계에서 추가 예정) ---
# AI_API_KEY=
